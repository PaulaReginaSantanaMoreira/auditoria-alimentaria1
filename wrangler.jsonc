{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bioaudit-pro",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_APP_NAME": "BioAudit Pro"
  }
}
