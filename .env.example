# =============================================================================
# BIOAUDIT PRO — ENVIRONMENT CONFIGURATION TEMPLATE
# Copie este arquivo para .env.local (ou .env.develop) e preencha com seus dados reais.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SUPABASE (BANCO DE DADOS POSTGRESQL & AUTENTICAÇÃO MULTI-TENANT)
# -----------------------------------------------------------------------------
# URL do projeto Supabase (visível no navegador)
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"

# Chave anônima pública (usada pelo cliente frontend, protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Chave de Serviço com privilégios de Admin (SOMENTE BACKEND / API ROUTES - NUNCA EXPOR NO CLIENTE)
# Necessária para criação de tenants, provisionamento de usuários e governança da plataforma
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# -----------------------------------------------------------------------------
# 2. SEGURANÇA CRIPTOGRÁFICA & JWT CORPORATIVO
# -----------------------------------------------------------------------------
# Chave secreta de alta entropia para assinatura de tokens de sessão (mínimo 32 caracteres).
# NUNCA use chaves públicas (como ANON_KEY) para assinar tokens.
# Como gerar chave segura: openssl rand -base64 32
# Como provisionar no Cloudflare Workers: npx wrangler secret put JWT_SECRET
JWT_SECRET="sua-chave-secreta-jwt-de-alta-entropia-minimo-32-caracteres"

# -----------------------------------------------------------------------------
# 3. SUPERUSUÁRIO DA PLATAFORMA (BOOTSTRAP INICIAL)
# -----------------------------------------------------------------------------
# E-mail de bootstrapping para provisionamento inicial do SuperAdmin (npm run create:superadmin)
SUPERADMIN_INITIAL_EMAIL="admin@bioauditpro.com"

# -----------------------------------------------------------------------------
# 4. DEPLOY CLOUDFLARE WORKERS (WRANGLER & CI/CD)
# -----------------------------------------------------------------------------
# ID da Conta Cloudflare (obtido no Dashboard da Cloudflare -> Workers & Pages)
CLOUDFLARE_ACCOUNT_ID="seu-account-id-cloudflare"

# Token de API Cloudflare com permissões de edição de Workers e deploy automatizado (npm run deploy)
CLOUDFLARE_API_TOKEN="seu-api-token-cloudflare"

