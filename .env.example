# =============================================================================
# BIOAUDIT PRO — ENVIRONMENT CONFIGURATION TEMPLATE
# Copie este arquivo para .env.local (ou .env.develop) e preencha com seus dados reais.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. MODO DA APLICAÇÃO (DEMO VS MUNDO REAL)
# -----------------------------------------------------------------------------
# Opções: "demo" (funciona 100% offline com IndexedDB e mocks) ou "production"/"development" (Supabase real)
NEXT_PUBLIC_APP_MODE="demo"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 2. SUPABASE (BANCO DE DADOS POSTGRESQL & AUTENTICAÇÃO MULTI-TENANT)
# -----------------------------------------------------------------------------
# URL do projeto Supabase (visível no navegador)
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"

# Chave anônima pública (usada pelo cliente frontend, protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Chave de Serviço com privilégios de Admin (SOMENTE BACKEND / API ROUTES - NUNCA EXPOR NO CLIENTE)
# Necessária para criação de tenants, provisionamento de usuários e auditorias de superusuário
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# -----------------------------------------------------------------------------
# 3. SUPABASE STORAGE (EVIDÊNCIAS FOTOGRÁFICAS & FIRMAS DIGITAIS)
# -----------------------------------------------------------------------------
# Buckets de armazenamento para imagens de inspeção sanitária e assinaturas em tela
NEXT_PUBLIC_STORAGE_BUCKET_EVIDENCES="audit-evidences"
NEXT_PUBLIC_STORAGE_BUCKET_SIGNATURES="audit-signatures"

# -----------------------------------------------------------------------------
# 4. CONFIGURAÇÕES MULTI-TENANT & SUPERUSUÁRIO DA PLATAFORMA
# -----------------------------------------------------------------------------
# E-mail e credenciais de bootstrapping do Superusuário mestre (Platform Admin)
SUPERADMIN_INITIAL_EMAIL="admin@bioauditpro.com"

# Limite padrão de inspectores/usuários ativos por nova empresa (gerenciado pelo Superusuário)
DEFAULT_TENANT_USER_SEATS=5

# Validade padrão em dias de novas subscrições homologadas (ex: 365 = 1 ano)
DEFAULT_SUBSCRIPTION_DAYS=365

# -----------------------------------------------------------------------------
# 5. SEGURANÇA CRIPTOGRÁFICA & JWT CORPORATIVO
# -----------------------------------------------------------------------------
# Chave secreta de alta entropia para assinatura de tokens de sessão (mínimo 32 caracteres).
# NUNCA use chaves públicas (como ANON_KEY) para assinar tokens.
# Como gerar chave segura: openssl rand -base64 32
# Como provisionar no Cloudflare Workers: npx wrangler secret put JWT_SECRET
JWT_SECRET="o3esgysviCmOrVLSSBxr+0/aINP4RdOGEEo8XooGvNw="

# -----------------------------------------------------------------------------
# 6. CLOUDFLARE PAGES / WORKERS (OPCIONAL PARA DEPLOY EM PRODUÇÃO)
# -----------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID="seu-account-id"
# CLOUDFLARE_API_TOKEN="seu-token"
